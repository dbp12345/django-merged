{
  "id": "/evernote/",
  "name": "Evernote Mirror",
  "short_name": "EN Mirror",
  "description": "A simple PWA mirror of Evernote notebooks and notes inside programmingbiz.",
  "start_url": "/evernote/",
  "scope": "/evernote/",
  "lang": "en-US",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f4efe7",
  "theme_color": "#2b6cb0",
  "orientation": "portrait",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/static/evernote_pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/evernote_pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/evernote_pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
