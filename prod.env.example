DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=prod.vectorops.xyz
DJANGO_CSRF_TRUSTED_ORIGINS=https://prod.vectorops.xyz
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_USE_WHITENOISE=1

# Pick one of: sqlite, mysql, postgres
DJANGO_DB_ENGINE=postgres
DJANGO_DB_NAME=vectorops_staging
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=replace-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

DJANGO_STATIC_ROOT=/var/www/prod.vectorops.xyz/static

# Keep these blank unless intentionally configured for staging
PRIVSER_API_KEY=
PRIVSER_API2_KEY=
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=
PAYCHEX_CLIENT_ID=
PAYCHEX_CLIENT_SECRET=
FLEXTIME_SHARED_KEY=
FLEXTIME_WSPASS=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://prod.vectorops.xyz/oauth/callback/
GHL_WEBHOOK_PUBLIC_KEY=
GHL_WEBHOOK_LEGACY_PUBLIC_KEY=
LD_WEBHOOK_SECRET=
LEARNDASH_BASE_URL=
LEARNDASH_USERNAME=
LEARNDASH_APP_PASSWORD=
